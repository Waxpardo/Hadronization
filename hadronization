#!/usr/bin/env python3
"""The single public command for the staged nominal pipeline."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parent
UNAVAILABLE = {
    "analyze": "ANALYZE-1",
    "merge": "ANALYZE-1",
    "reduce": "ANALYZE-1",
    "plot": "PLOT-1",
}


def load_site():
    path = ROOT / "config/site.conf"
    values = {}
    if not path.is_file():
        return values
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.*)", line)
        if not match:
            raise ValueError("{}:{} is not KEY=VALUE".format(path, number))
        value = match.group(2).strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[match.group(1)] = value
    return values


def version(command, arguments):
    if not command:
        return "unavailable"
    try:
        result = subprocess.run([command] + arguments, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return "unavailable"
    first = result.stdout.strip().splitlines()
    return first[0] if result.returncode == 0 and first else "unavailable"


def doctor():
    try:
        site = load_site()
        study = json.loads((ROOT / "config/study.json").read_text(encoding="utf-8"))
        campaign = json.loads((ROOT / "data/campaign.json").read_text(encoding="utf-8"))
        manifest = json.loads((ROOT / "results/manifest.json").read_text(encoding="utf-8"))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print("REQUIRED configuration: FAIL ({})".format(error))
        return 1
    git = shutil.which("git")
    head = version(git, ["-C", str(ROOT), "rev-parse", "--short=12", "HEAD"])
    python_ok = sys.version_info >= (3, 9)
    print("REQUIRED repository: {} ({})".format("OK" if (ROOT / ".git").is_dir() else "FAIL", head))
    print("REQUIRED configuration: {} / {} / {}".format(
        study.get("schema"), campaign.get("schema"), manifest.get("schema")))
    print("REQUIRED Python: {} ({})".format("OK" if python_ok else "FAIL", sys.version.split()[0]))
    root_config = site.get("ROOT_CONFIG") or shutil.which("root-config")
    pythia_config = site.get("PYTHIA8_CONFIG") or shutil.which("pythia8-config")
    pythia_prefix = site.get("PYTHIA8_PREFIX")
    cxx = site.get("CXX") or shutil.which("c++") or shutil.which("g++")
    print("OPTIONAL ROOT: {}".format(version(root_config, ["--version"])))
    if pythia_config:
        pythia = version(pythia_config, ["--version"])
    elif pythia_prefix and Path(pythia_prefix).is_dir():
        pythia = "configured prefix {}".format(pythia_prefix)
    else:
        pythia = "unavailable"
    print("OPTIONAL PYTHIA: {}".format(pythia))
    print("OPTIONAL compiler: {}".format(version(cxx, ["--version"])))
    print("OPTIONAL site: {}".format(
        ROOT / "config/site.conf" if (ROOT / "config/site.conf").is_file() else "portable defaults"))
    return 0 if python_ok and (ROOT / ".git").is_dir() else 1


def is_within(path, parent):
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def clean_candidates():
    candidates = []
    protected_raw = ROOT / "data/raw"
    for current, directories, files in os.walk(str(ROOT), topdown=True, followlinks=False):
        here = Path(current)
        directories[:] = sorted(d for d in directories if d != ".git")
        if here == ROOT:
            if ".local-data" in directories:
                candidates.append(ROOT / ".local-data")
                directories.remove(".local-data")
        if here == ROOT / "data" and "raw" in directories:
            directories.remove("raw")
        for directory in list(directories):
            path = here / directory
            if directory == "__pycache__":
                candidates.append(path)
                directories.remove(directory)
            elif path == ROOT / "plotting/Plots":
                candidates.append(path)
                directories.remove(directory)
        for name in sorted(files):
            path = here / name
            if name == ".DS_Store" or path.suffix in {".pyc", ".so", ".d", ".pcm"}:
                if not is_within(path.absolute(), protected_raw.absolute()):
                    candidates.append(path)
    unique = {path.absolute() for path in candidates}
    return sorted(unique, key=lambda path: path.relative_to(ROOT).as_posix())


def clean(apply_changes):
    root_resolved = ROOT.resolve()
    raw_absolute = (ROOT / "data/raw").absolute()
    candidates = clean_candidates()
    failures = []
    for path in candidates:
        if not is_within(path, ROOT.absolute()) or is_within(path, raw_absolute):
            failures.append("protected or non-repository path: {}".format(path))
            continue
        resolved = path.resolve(strict=False)
        if not is_within(resolved, root_resolved):
            failures.append("target resolves outside repository: {} -> {}".format(path, resolved))
    if failures:
        for failure in failures:
            print("REFUSE {}".format(failure), file=sys.stderr)
        return 2
    for path in candidates:
        print("REMOVE {}".format(path.relative_to(ROOT).as_posix()))
    if not candidates:
        print("CLEAN no targets")
    if not apply_changes:
        print("DRY-RUN no files removed")
        return 0
    for path in sorted(candidates, key=lambda item: len(item.parts), reverse=True):
        if path.is_symlink() or path.is_file():
            path.unlink()
        elif path.is_dir():
            shutil.rmtree(str(path))
    print("APPLIED removed {} target(s)".format(len(candidates)))
    return 0


def verify():
    python = os.environ.get("PYTHON") or sys.executable
    environment = os.environ.copy()
    environment.pop("HADRONIZATION_DATASET", None)
    command = [python, "-m", "unittest", "discover", "-v", "-s",
               str(ROOT / "tests"), "-p", "test_*.py"]
    return subprocess.run(command, cwd=str(ROOT), env=environment).returncode


def generate(submit):
    command = [sys.executable, str(ROOT / "pipeline/generate/submit.py"), "plan"]
    if submit:
        command.append("--submit")
    return subprocess.run(command, cwd=str(ROOT)).returncode


def build_parser():
    parser = argparse.ArgumentParser(
        prog="hadronization",
        description=("Nominal statistical-only pipeline. The accepted migration baseline "
                     "is present; analysis and plotting successors are staged separately."))
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor", help="report required and optional capabilities")
    generate_parser = sub.add_parser("generate", help="build/describe nominal generation work")
    generate_parser.add_argument("--submit", action="store_true",
                                 help="contact the configured scheduler explicitly")
    for name in ("analyze", "merge", "reduce", "plot"):
        sub.add_parser(name, help="intentionally unavailable in CLEAN-1")
    sub.add_parser("verify", help="run the focused active-contract suite")
    clean_parser = sub.add_parser("clean", help="remove reproducible checkout residue")
    clean_mode = clean_parser.add_mutually_exclusive_group()
    clean_mode.add_argument("--dry-run", action="store_true")
    clean_mode.add_argument("--apply", action="store_true")
    return parser


def main():
    args = build_parser().parse_args()
    if args.command == "doctor":
        return doctor()
    if args.command == "generate":
        return generate(args.submit)
    if args.command in UNAVAILABLE:
        print("ERROR: {} not implemented until {}".format(
            args.command, UNAVAILABLE[args.command]), file=sys.stderr)
        return 3
    if args.command == "verify":
        return verify()
    if args.command == "clean":
        return clean(args.apply)
    return 2


if __name__ == "__main__":
    sys.exit(main())
