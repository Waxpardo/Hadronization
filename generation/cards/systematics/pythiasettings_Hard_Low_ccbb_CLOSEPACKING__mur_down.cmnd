! ====================================================================
! GENERATED SYSTEMATICS VARIATION -- DO NOT EDIT
!
! tools/make_systematic_cards.py, from
!   generation/cards/pythiasettings_Hard_Low_ccbb_CLOSEPACKING.cmnd
!   sha256 dd0755ae85c340f7e3a438931bed14afa433220f164f84fcb0e18d4ae6f2f4de
!
! variation : mur_down   (S1)
! setting   : SigmaProcess:renormMultFac = 0.5
! nominal   : 1. (PYTHIA default; the nominal cards do not set it)
!
! This card differs from the nominal by EXACTLY ONE setting, which the generator
! asserts rather than assumes. Registered in docs/SYSTEMATICS_PREREGISTRATION.md
! S1. Where the nominal card carried a comment on the changed
! setting, that comment is left in place and describes the NOMINAL choice.
! ====================================================================
! Called from file: heavyflavourcorrelations_status.cpp
! Single PYTHIA run saving both charm and beauty hadrons for balancing studies
! Close Packing T1 tune
! Lines starting with (!) are comments

! General settings
Main:numberOfEvents = 1000000

Init:showMultipartonInteractions = off
Init:showChangedParticleData = off
Next:numberCount = 0
Next:numberShowEvent = 0
Next:numberShowInfo = 0
Next:numberShowProcess = 0

! Beams and tune
Beams:eCM = 13600                              ! sqrt(s) = 13.6 TeV (LHC Run 3), eCM in GeV
Beams:idA = 2212
Beams:idB = 2212
Tune:pp = 14

! Close Packing T1 tune parameters
StringZ:useOldAExtra = off
StringPT:sigma = 0.335
StringZ:aLund = 0.68
StringZ:bLund = 0.98
StringFlav:probQQtoQ = 0.081
StringFlav:probStoUD = 0.217
StringFlav:probQQ1toQQ0join = 0.5,0.7,0.9,1.0

MultipartonInteractions:pT0Ref = 2.194

BeamRemnants:remnantMode = 1
BeamRemnants:saturation = 5

ColourReconnection:mode = 1
ColourReconnection:timeDilationMode = 2
ColourReconnection:allowDoubleJunRem = off
ColourReconnection:allowJunctions = on
ColourReconnection:mPseudo = 0.403
ColourReconnection:m0 = 0.618
ColourReconnection:junctionCorrection = 1.349
ColourReconnection:timeDilationPar = 0.18

ClosePacking:doClosePacking = on
ClosePacking:enhanceStrange = 0.014
ClosePacking:enhancePT = 0.014
ClosePacking:PT0 = 2.0
ClosePacking:doEnhanceDiquark = off

StringFragmentation:doStrangeJunctions = on
StringFragmentation:enhanceStrangeJunction = 0.540

ClosePacking:baryonSup = 0.928
ClosePacking:parallelBaryonSup = 0

Ropewalk:RopeHadronization = off

! Physics part
! Enable BOTH heavy-flavour channels in the same run
HardQCD:hardccbar = on
HardQCD:hardbbbar = on

! Processes become divergent at low pT, need to define a lower bound.
!
! 2.0 GeV, not 1.0, because event-activity classification is central to this
! study. MultipartonInteractions:pT0Ref is 2.28 GeV: a threshold below that
! asks for the hardest interaction in the event to be softer than the MPI
! screening scale, which selects events with suppressed underlying activity.
! Measured on 8.317, dN_ch/deta was 4.973 at pTHatMin 1.0 against 6.968 for
! minimum bias -- 29% BELOW MB despite requiring a hard scattering -- so
! percentiles taken inside that sample are not the classes an experiment
! slices. At 2.0 the sample sits within 4.2% of minimum bias and the classes
! mean what they say.
!
! This does NOT cost trigger statistics, contrary to the obvious worry. The
! analysis already requires trigger pT > 1 GeV, and at pTHatMin 1.0 much of the
! charm produced falls below that and never becomes a trigger. Measured on
! 100k MONASH events: charm triggers per event rose 0.990 -> 1.196 (+21%) and
! beauty 0.126 -> 0.212 (+68%) on moving 1.0 -> 2.0. The generated cross
! section is smaller, but this is a generator study with a chosen event count,
! so that does not enter.
! See ValidationReports/PTHAT_MULTIPLICITY_SCAN_8317.md.
PhaseSpace:pTHatMin = 2.

! Light-particle decay policy. The producer programmatically disables every
! recognized charm- or beauty-containing hadron after reading this card and
! writes the complete ParticleData audit to the ROOT output.
ParticleDecays:limitTau0 = on
ParticleDecays:tau0Max = 0.01

! --- systematics variation mur_down: absent from the nominal card, so the nominal is the PYTHIA default ---
SigmaProcess:renormMultFac = 0.5
