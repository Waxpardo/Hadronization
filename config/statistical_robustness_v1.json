    "pair_combinatorics_mode": "ordered_conditional_v1",
    "same_sign_pair_factor": 1.0,
    "species_registry_sha256": "946828956f1b30ae7cb4d28c0c0687e8522b7349db127a067311c77bc3e21529",
    "pair_registry_schema": "heavy_flavour_pair_registry_v1",
    "pair_registry_sha256": "ea9b0232c1be84158446e559e23aebf3410b3c8a6e39a221d367f0d0c7ddee23",
    "pair_registry_path": "config/heavy_flavour_pair_registry_v1.json",
