
# Large binary outputs
/RootFiles/**/*.root
.DS_Store
.vscode/
__pycache__/
/logs/*

# Ignore ROOT files by default
#*.root

# But keep analyzed outputs
!AnalyzedData/
!AnalyzedData/**/*.root

# Ignore generated production analysis outputs
/AnalysisResults/
/AnalyzedData/complete_root_*/
/AnalyzedData/SUBSAMPLES_*/
/.root_hist
/submit_status_analysis_*.sub
/submitCondor_hf_*_50job_separate.sub

# Ignore job outputs and logs
logs/
/Logs/
Jobs/
compile_hf.log
Jobs/HF/**/hf_*.root

# Local production scratch and backup directories
/AnalyzedData/_merge_benchmark/
/AnalyzedData/interrupted_*/
/AnalyzedData/pre_pr9_v4_backup_*/

# Ignore ROOT ACLiC/build artifacts
*_C.so
*_C.d
*_ACLiC_dict_rdict.pcm
*.pcm

# Ignore generated plot outputs
PlottingScripts/Plots/
PlottingScripts/**/Plots/
Balancing_and_Sampling/**/Plots/

# Machine-generated validation reports can contain host-local provenance paths.
# Keep the validators and human-readable handoff in Git; retain JSON/log output
# in the internal checkout that produced it.
/PlottingScripts/validation/*.json
/PlottingScripts/validation/*.log

# Ignore built executables
SimulationScripts/heavyflavourcorrelations_status
SimulationScripts/bbbarcorrelations_status
SimulationScripts/bbbarcorrelations_status_JUNCTIONS
SimulationScripts/ccbarcorrelations_status_JUNCTIONS

# Scratch/tooling directories
.codex-tmp/

# Machine-specific base path (each machine keeps its own copy)
base_path.txt
