
# Large binary outputs
/RootFiles/**/*.root
.DS_Store
.vscode/
__pycache__/
/logs/*

# Analysis ROOT output is data, not code. It lived in git until 2026-08-03
# (213 files, ~25 MB) behind a "!AnalyzedData/**/*.root" exception; the files
# are untracked now but deliberately KEPT on Nikhef storage, because it is not
# clear they can be regenerated and run_paper_plots.sh:155-156 still defaults
# to two of those dated tags.
/AnalyzedData/**/*.root
/AnalyzedData/**/*.zip

# Ignore generated production analysis outputs
/Production/
/campaigns/
# NOT /Analysis/ -- removed 2026-08-13. `analysis/` is the SOURCE directory in
# the current layout, and on a case-insensitive filesystem (core.ignorecase=true
# on macOS) `/Analysis/` matched it and silently ignored every newly added
# source file there. Git applies ignore rules only to UNTRACKED paths, so the
# files added before the restructure kept working and the trap was invisible:
# analysis/a2_block_shift.py -- the gated A2 analyzer the pre-registration hangs
# on -- and analysis/a2_pair_yield.C were never committed at all. Nothing in the
# repository generates a directory by this name; the rule was stale.
/AnalysisOutput/
/AnalysisResults/
/AnalyzedData/complete_root_*/
/AnalyzedData/SUBSAMPLES_*/
/.root_hist
/submit_status_analysis_*.sub
/submitCondor_hf_*_50job_separate.sub

# Ignore job outputs and logs
logs/
/Logs/
Jobs/
compile_hf.log
Jobs/HF/**/hf_*.root

# Local production scratch and backup directories
/AnalyzedData/_merge_benchmark/
/AnalyzedData/interrupted_*/
/AnalyzedData/pre_pr9_v4_backup_*/

# Ignore ROOT ACLiC/build artifacts
*_C.so
*_C.d
*_ACLiC_dict_rdict.pcm
*.pcm

# Ignore generated plot outputs
plotting/Plots/
plotting/**/Plots/
Balancing_and_Sampling/**/Plots/

# Machine-generated validation reports can contain host-local provenance paths.
# Keep the validators and human-readable handoff in Git; retain JSON/log output
# in the internal checkout that produced it.
/plotting/validation/*.json
/plotting/validation/*.log

# Ignore built executables
SimulationScripts/heavyflavourcorrelations_status
SimulationScripts/bbbarcorrelations_status
SimulationScripts/bbbarcorrelations_status_JUNCTIONS
SimulationScripts/ccbarcorrelations_status
SimulationScripts/ccbarcorrelations_status_JUNCTIONS

# Working paper draft. Kept in the checkout as reference only; it is
# deliberately untracked so plotting/production branches never overwrite it.
Paper/Heavy_flavour_hadronisation_model_paper/

# Scratch/tooling directories
.codex-tmp/

# Machine-specific base path (each machine keeps its own copy)
base_path.txt

# Machine-specific dependency overrides (see config/dependencies.local.conf.example)
config/dependencies.local.conf

# Rendered Condor submit files. Every renderer's output pattern belongs here:
#   Makefile:153          submit_<CAMPAIGN>_smoke.sub     (make submit-smoke)
#   Makefile:164          submit_<CAMPAIGN>_prelim.sub    (make submit-prelim)
#   Makefile:174          submit_<CAMPAIGN>_full.sub      (make submit-full)
#   resubmit_held.py:149  submit_<CAMPAIGN>_retry<N>.sub  (make resubmit APPLY=1)
# The smoke and retry patterns were missing, so those files were untracked
# rather than ignored: `git add -A` would have committed them and
# `git stash -u` would have swallowed them. Both have bitten before.
submit_*_smoke.sub
submit_*_prelim.sub
submit_*_full.sub
submit_*_retry*.sub

# Burned-seed ledger is machine/campaign state, not code
config/burned_seeds.txt

# ASD-STE100 Issue 9, the writing standard's source specification.
# The PDF stays in the working tree and never enters git. Its page 2 grants
# universities and research institutes free use, reproduction and publication,
# so holding it here is inside the grant. Publishing it is a separate act:
# `origin` is github.com/Waxpardo/Hadronization, and a commit that carries the
# blob publishes it on the first push. docs/writing_standard/STANDARD.md and
# pdf-page-map.md both say do not commit it.
# Git history is permanent, so this rule fails closed rather than relying on a
# later export step to strip the file.
/docs/writing_standard/ASD-STE100_ISSUE9.pdf

# Third-party literature. Never committed.
Sources/

# Built producer. The SimulationScripts rules above are stale since the
# 2026-08-12 restructure; this is where the binary lands now.
generation/producer/heavyflavourcorrelations_status
